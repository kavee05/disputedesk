# Copy this file to .env and fill in your own values.
# .env and .env.local are gitignored. Never commit real credentials.
# Every variable is optional: with nothing set, DisputeDesk runs in demo mode
# with simulated PayPal data and offline rules instead of AI.

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Use a US sandbox Business account, see FEASIBILITY.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is accepted. The app refuses to start with anything else.
PAYPAL_ENV=sandbox
# Set to true to use the simulated PayPal adapter even when credentials are set.
DEMO_MODE=

# AI provider. Gemini is used when GEMINI_API_KEY is set (free key at aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# "low" answers in about 5 seconds. Leave as low unless you have a reason.
GEMINI_THINKING_LEVEL=low
# Optional alternative: Anthropic Claude. Set AI_PROVIDER=anthropic to prefer it.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: protects buttons that change data on a public deployment.
ADMIN_PASSCODE=

# Where the SQLite file lives.
DATABASE_PATH=data/disputedesk.db
