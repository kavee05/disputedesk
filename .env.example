# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is supported. The app refuses to start with anything else.
PAYPAL_ENV=sandbox

# Added in Phase 2 (agent pipeline). Not needed for the Phase 0 probes.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
