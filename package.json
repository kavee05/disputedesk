{
  "name": "disputedesk",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent that defends small sellers against PayPal disputes (PayPal Sandbox only).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "probe:auth": "tsx scripts/feasibility/auth.ts",
    "probe:orders": "tsx scripts/feasibility/orders.ts",
    "probe:disputes": "tsx scripts/feasibility/disputes.ts",
    "probe:chargeback": "tsx scripts/feasibility/chargeback.ts",
    "probe:toolkit": "tsx scripts/feasibility/toolkit.ts",
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/run.mjs demo",
    "go": "node scripts/run.mjs prod"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.9"
  }
